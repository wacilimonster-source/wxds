<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/bgPaper"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 搜索框：胶囊容器，聚焦描边转朱砂 -->
    <LinearLayout
        android:id="@+id/searchField"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_search_field_off"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="14dp"
        android:paddingStart="14dp"
        android:paddingEnd="6dp"
        android:layout_width="match_parent"
        android:layout_height="44dp">

        <ImageView
            android:src="@drawable/ic_search"
            android:importantForAccessibility="no"
            android:layout_width="16dp"
            android:layout_height="16dp"
            app:tint="@color/ink3" />

        <EditText
            android:id="@+id/etSearch"
            android:hint="输入标题关键词搜索"
            android:textColorHint="@color/ink3"
            android:textColor="@color/inkPrimary"
            android:background="@android:color/transparent"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:singleLine="true"
            android:layout_marginStart="10dp"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:backgroundTint="@android:color/transparent" />

        <ImageButton
            android:id="@+id/btnClear"
            android:contentDescription="清除"
            android:src="@drawable/ic_close"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/ink3" />
    </LinearLayout>

    <!-- 搜索历史（输入框为空且有过搜索时显示）：点击即搜，长按删除 -->
    <HorizontalScrollView
        android:id="@+id/historyBar"
        android:scrollbars="none"
        android:visibility="gone"
        android:paddingStart="20dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="6dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:id="@+id/historyRow"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </HorizontalScrollView>

    <!-- 区筛选 + 排序（有搜索词后出现） -->
    <LinearLayout
        android:id="@+id/filterBar"
        android:visibility="gone"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <HorizontalScrollView
            android:scrollbars="none"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content">
            <LinearLayout
                android:id="@+id/zoneRow"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </HorizontalScrollView>
        <TextView
            android:id="@+id/tvSearchSort"
            android:text="@string/fav_sort"
            android:textSize="13sp"
            android:textColor="@color/accent"
            android:background="?attr/selectableItemBackground"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- 结果列表 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler"
            android:clipToPadding="false"
            android:paddingBottom="8dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:id="@+id/emptyBox"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:src="@drawable/ic_empty_book"
                android:importantForAccessibility="no"
                android:layout_width="96dp"
                android:layout_height="72dp"
                android:alpha="0.9" />
            <TextView
                android:id="@+id/tvEmptyTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/inkPrimary"
                android:textSize="15sp"
                android:layout_marginTop="14dp" />
            <TextView
                android:id="@+id/tvEmptyHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/inkSecondary"
                android:textSize="12sp"
                android:gravity="center"
                android:paddingStart="32dp"
                android:paddingEnd="32dp" />
        </LinearLayout>

        <!-- 首屏加载骨架（呼吸动画） -->
        <include
            android:id="@+id/skeleton"
            layout="@layout/skeleton_cards"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
