<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/bgPaper"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 顶栏：书架 + 排序/清空（随段切换显隐） -->
    <LinearLayout
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="12dp"
        android:paddingTop="14dp"
        android:paddingBottom="6dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:text="@string/favorites_title"
            android:textColor="@color/inkPrimary"
            android:textSize="22sp"
            android:fontFamily="serif"
            android:textStyle="bold"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content" />
        <TextView
            android:id="@+id/tvFavSort"
            android:text="@string/fav_sort"
            android:textSize="13sp"
            android:textColor="@color/accent"
            android:background="?attr/selectableItemBackground"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
        <TextView
            android:id="@+id/tvFavClear"
            android:text="@string/clear_recent"
            android:textSize="13sp"
            android:textColor="@color/accent"
            android:background="?attr/selectableItemBackground"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- 段切换：最近 / 收藏 -->
    <HorizontalScrollView
        android:scrollbars="none"
        android:paddingStart="20dp"
        android:paddingEnd="12dp"
        android:paddingBottom="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/sectionGroup"
            app:singleSelection="true"
            app:selectionRequired="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSectionRecent"
                style="@style/Widget.Material3.Button.TonalButton"
                android:text="@string/section_recent"
                android:textSize="12sp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:minWidth="0dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:layout_width="wrap_content"
                android:layout_height="34dp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSectionFav"
                style="@style/Widget.Material3.Button.TonalButton"
                android:text="@string/section_fav"
                android:textSize="12sp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:minWidth="0dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:layout_marginStart="6dp"
                android:layout_width="wrap_content"
                android:layout_height="34dp" />
        </com.google.android.material.button.MaterialButtonToggleGroup>
    </HorizontalScrollView>

    <!-- 区筛选 -->
    <HorizontalScrollView
        android:scrollbars="none"
        android:paddingStart="20dp"
        android:paddingEnd="12dp"
        android:paddingBottom="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/filterGroup"
            app:singleSelection="true"
            app:selectionRequired="true"
            app:checkedButton="@id/btnFilterAll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFilterAll"
                style="@style/Widget.Material3.Button.TonalButton"
                android:text="@string/filter_all"
                android:textSize="12sp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:minWidth="0dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:layout_width="wrap_content"
                android:layout_height="34dp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFilterLit"
                style="@style/Widget.Material3.Button.TonalButton"
                android:text="@string/tab_lit"
                android:textSize="12sp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:minWidth="0dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:layout_marginStart="6dp"
                android:layout_width="wrap_content"
                android:layout_height="34dp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFilterImg"
                style="@style/Widget.Material3.Button.TonalButton"
                android:text="@string/tab_img"
                android:textSize="12sp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:minWidth="0dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:layout_marginStart="6dp"
                android:layout_width="wrap_content"
                android:layout_height="34dp" />
        </com.google.android.material.button.MaterialButtonToggleGroup>
    </HorizontalScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler"
            android:clipToPadding="false"
            android:paddingBottom="8dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:id="@+id/emptyBox"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:id="@+id/tvEmptyTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/empty_fav_title"
                android:textColor="@color/inkPrimary"
                android:textSize="15sp" />
            <TextView
                android:id="@+id/tvEmptyHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/empty_fav_hint"
                android:textColor="@color/inkSecondary"
                android:textSize="12sp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progress"
            android:layout_gravity="center"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </FrameLayout>
</LinearLayout>
