<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/bgPaper"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 顶栏：书架 + 排序/清空（随段切换显隐） -->
    <LinearLayout
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="12dp"
        android:paddingTop="14dp"
        android:paddingBottom="6dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:text="@string/favorites_title"
            android:textColor="@color/inkPrimary"
            android:textSize="22sp"
            android:fontFamily="serif"
            android:textStyle="bold"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/tvFavSort"
            android:text="@string/fav_sort"
            android:textSize="13sp"
            android:textColor="@color/accent"
            android:background="?attr/selectableItemBackground"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/tvFavClear"
            android:text="@string/clear_recent"
            android:textSize="13sp"
            android:textColor="@color/accent"
            android:background="?attr/selectableItemBackground"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- 段切换：最近 / 收藏（分段控件） -->
    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/sectionGroup"
        style="@style/SegmentGroup"
        app:singleSelection="true"
        app:selectionRequired="true"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="4dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSectionRecent"
            style="@style/SegmentButton"
            android:text="@string/section_recent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSectionFav"
            style="@style/SegmentButton"
            android:text="@string/section_fav"
            android:layout_marginStart="2dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <!-- 区筛选 chips -->
    <HorizontalScrollView
        android:scrollbars="none"
        android:paddingStart="20dp"
        android:paddingEnd="12dp"
        android:paddingBottom="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:id="@+id/filterRow"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </HorizontalScrollView>

    <!-- 继续阅读置顶卡（仅最近段显示） -->
    <androidx.cardview.widget.CardView
        android:id="@+id/continueCard"
        android:visibility="gone"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginTop="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/bg_hero"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="13dp"
            android:paddingBottom="14dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvContinueLabel"
                android:textSize="11sp"
                android:textColor="@color/accentDeep"
                android:letterSpacing="0.05"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/tvContinueTitle"
                android:textSize="19sp"
                android:textColor="@color/inkPrimary"
                android:fontFamily="serif"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginTop="3dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <LinearLayout
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ProgressBar
                    android:id="@+id/continueProgress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="4dp"
                    android:progressDrawable="@drawable/bg_progress_thin"
                    android:max="100" />

                <TextView
                    android:id="@+id/tvContinuePercent"
                    android:textSize="11.5sp"
                    android:textColor="@color/inkSecondary"
                    android:layout_marginStart="10dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnContinue"
                android:text="@string/continue_reading"
                android:textSize="12sp"
                android:textColor="@color/onPrimary"
                android:background="@drawable/bg_btn_accent"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"
                android:layout_marginTop="11dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler"
            android:clipToPadding="false"
            android:paddingBottom="8dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:id="@+id/emptyBox"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:src="@drawable/ic_empty_book"
                android:importantForAccessibility="no"
                android:layout_width="96dp"
                android:layout_height="72dp"
                android:alpha="0.9" />
            <TextView
                android:id="@+id/tvEmptyTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/empty_fav_title"
                android:textColor="@color/inkPrimary"
                android:textSize="15sp"
                android:layout_marginTop="14dp" />
            <TextView
                android:id="@+id/tvEmptyHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/empty_fav_hint"
                android:textColor="@color/inkSecondary"
                android:textSize="12sp"
                android:gravity="center"
                android:paddingStart="32dp"
                android:paddingEnd="32dp" />
            <TextView
                android:id="@+id/btnEmptyAction"
                android:text="@string/empty_action_browse"
                android:textSize="13sp"
                android:textColor="@color/onPrimary"
                android:background="@drawable/bg_btn_accent"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_marginTop="16dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- 首屏加载骨架（呼吸动画） -->
        <include
            android:id="@+id/skeleton"
            layout="@layout/skeleton_cards"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
