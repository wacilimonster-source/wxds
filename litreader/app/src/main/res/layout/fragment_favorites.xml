<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/bgPaper"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 顶栏：收藏夹 -->
    <TextView
        android:text="@string/favorites_title"
        android:textColor="@color/inkPrimary"
        android:textSize="22sp"
        android:fontFamily="serif"
        android:textStyle="bold"
        android:paddingStart="20dp"
        android:paddingEnd="12dp"
        android:paddingTop="14dp"
        android:paddingBottom="6dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- 区筛选 -->
    <HorizontalScrollView
        android:scrollbars="none"
        android:paddingStart="20dp"
        android:paddingEnd="12dp"
        android:paddingBottom="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/filterGroup"
            app:singleSelection="true"
            app:selectionRequired="true"
            app:checkedButton="@id/btnFilterAll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFilterAll"
                style="@style/Widget.Material3.Button.TonalButton"
                android:text="@string/filter_all"
                android:textSize="12sp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:minWidth="0dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:layout_width="wrap_content"
                android:layout_height="34dp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFilterLit"
                style="@style/Widget.Material3.Button.TonalButton"
                android:text="@string/tab_lit"
                android:textSize="12sp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:minWidth="0dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:layout_marginStart="6dp"
                android:layout_width="wrap_content"
                android:layout_height="34dp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFilterImg"
                style="@style/Widget.Material3.Button.TonalButton"
                android:text="@string/tab_img"
                android:textSize="12sp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:minWidth="0dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:layout_marginStart="6dp"
                android:layout_width="wrap_content"
                android:layout_height="34dp" />
        </com.google.android.material.button.MaterialButtonToggleGroup>
    </HorizontalScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler"
            android:clipToPadding="false"
            android:paddingBottom="8dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:id="@+id/emptyBox"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/empty_fav_title"
                android:textColor="@color/inkPrimary"
                android:textSize="15sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/empty_fav_hint"
                android:textColor="@color/inkSecondary"
                android:textSize="12sp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progress"
            android:layout_gravity="center"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </FrameLayout>
</LinearLayout>
