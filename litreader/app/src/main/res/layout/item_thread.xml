<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/bgSurface"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/divider">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:paddingStart="16dp"
        android:paddingEnd="6dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- 贴图缩略 72dp：无图占位图标，失败显示重试（仅贴图列表可见） -->
        <FrameLayout
            android:id="@+id/thumbWrap"
            android:visibility="gone"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_width="72dp"
            android:layout_height="72dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/imgThumb"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                android:background="@color/bgPaper"
                app:shapeAppearanceOverlay="@style/ThumbShape"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- 无图/加载失败占位：图标 + 可见重试入口（状态不只靠颜色） -->
            <LinearLayout
                android:id="@+id/thumbPlaceholder"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@color/bgPaper"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/thumbPlaceholderIcon"
                    android:src="@drawable/ic_image"
                    android:importantForAccessibility="no"
                    android:alpha="0.5"
                    app:tint="@color/ink3"
                    android:layout_width="22dp"
                    android:layout_height="22dp" />

                <TextView
                    android:id="@+id/thumbRetry"
                    android:text="@string/thumb_retry"
                    android:textSize="12sp"
                    android:textColor="@color/accent"
                    android:background="?attr/selectableItemBackground"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </FrameLayout>

        <!-- 文本主体：标题 17sp 最多两行，元信息 12sp；短标题卡垂直居中 -->
        <LinearLayout
            android:id="@+id/cbody"
            android:orientation="vertical"
            app:layout_constraintStart_toEndOf="@id/thumbWrap"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/actionDivider"
            android:layout_marginEnd="6dp"
            app:layout_constraintHorizontal_bias="0"
            android:layout_width="0dp"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvTitle"
                android:textSize="17sp"
                android:textColor="@color/inkPrimary"
                android:textFontWeight="500"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.012"
                android:maxLines="2"
                android:ellipsize="end"
                android:lineSpacingExtra="4dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <LinearLayout
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="6dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tvTag"
                    android:textSize="12sp"
                    android:textColor="@color/accentDeep"
                    android:background="@drawable/bg_tagpill"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/tvMeta"
                    android:textSize="12sp"
                    android:textColor="@color/inkSecondary"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- 状态行：带名称的回复/赞数 + 已打开/已读完/进度（12sp，非仅颜色区分） -->
            <LinearLayout
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="5dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tvCounts"
                    android:textSize="12sp"
                    android:textColor="@color/inkSecondary"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/tvReadMark"
                    android:textSize="12sp"
                    android:textColor="@color/inkSecondary"
                    android:drawablePadding="5dp"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:layout_marginStart="6dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- 底部阅读进度细线（已读部分进度 / 已读完满条） -->
            <ProgressBar
                android:id="@+id/progressLine"
                style="?android:attr/progressBarStyleHorizontal"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginTop="8dp"
                android:progressDrawable="@drawable/bg_progress_thin"
                android:max="100" />
        </LinearLayout>

        <!-- 操作列左缘的纸感竖分隔线（上下各内缩 10dp） -->
        <View
            android:id="@+id/actionDivider"
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:background="@color/divider"
            app:layout_constraintEnd_toStartOf="@id/actions"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- 右侧操作列：48dp 收藏按钮（可点、有选中态） + 48dp 更多菜单 -->
        <LinearLayout
            android:id="@+id/actions"
            android:orientation="vertical"
            android:gravity="center"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp">

                <!-- 收藏选中态：32dp accentSoft 圆底（触摸目标仍为 48dp） -->
                <View
                    android:id="@+id/favBg"
                    android:visibility="invisible"
                    android:background="@drawable/bg_fav_on"
                    android:layout_gravity="center"
                    android:layout_width="32dp"
                    android:layout_height="32dp" />

                <ImageView
                    android:id="@+id/imgFav"
                    android:src="@drawable/ic_star_outline"
                    app:tint="@color/inkSecondary"
                    android:contentDescription="@string/item_favorite_cd"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:scaleType="center"
                    android:layout_width="48dp"
                    android:layout_height="48dp" />
            </FrameLayout>

            <ImageView
                android:id="@+id/btnDislike"
                android:src="@drawable/ic_thumb_down"
                app:tint="@color/inkSecondary"
                android:contentDescription="@string/item_dislike_cd"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:scaleType="center"
                android:layout_width="48dp"
                android:layout_height="48dp" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
