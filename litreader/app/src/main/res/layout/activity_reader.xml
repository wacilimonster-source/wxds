<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 正文容器 -->
    <FrameLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/pager"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ScrollView
            android:id="@+id/scrollWrap"
            android:visibility="gone"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextView
                android:id="@+id/scrollText"
                android:textSize="17sp"
                android:lineSpacingMultiplier="1.9"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:paddingTop="26dp"
                android:paddingBottom="44dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </ScrollView>

        <!-- 错误/空态 -->
        <LinearLayout
            android:id="@+id/errorBox"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:src="@drawable/ic_empty_book"
                android:importantForAccessibility="no"
                android:alpha="0.6"
                android:layout_width="72dp"
                android:layout_height="54dp" />
            <TextView
                android:id="@+id/tvError"
                android:textSize="14sp"
                android:layout_marginTop="12dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
            <LinearLayout
                android:orientation="horizontal"
                android:layout_marginTop="14dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:id="@+id/btnRetry"
                    android:text="@string/retry"
                    android:textSize="14sp"
                    android:textColor="@color/galleryOnDark"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:background="@drawable/bg_reader_menu_item"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
                <TextView
                    android:id="@+id/btnErrorForum"
                    android:text="@string/reader_forum"
                    android:textSize="14sp"
                    android:textColor="@color/galleryOnDark"
                    android:layout_marginStart="12dp"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:background="@drawable/bg_reader_menu_item"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <ProgressBar
        android:id="@+id/progress"
        android:layout_gravity="center"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <!-- 菜单-顶部 -->
    <LinearLayout
        android:id="@+id/menuTop"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/readerMenuBg"
        android:paddingStart="8dp"
        android:paddingEnd="14dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageButton
            android:id="@+id/btnBack"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/galleryOnDark" />
        <TextView
            android:id="@+id/tvTitle"
            android:textSize="15sp"
            android:textColor="@color/galleryOnDark"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginStart="4dp"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content" />
        <ImageButton
            android:id="@+id/btnFav"
            android:contentDescription="@string/favorite_add"
            android:src="@drawable/ic_star_outline"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/galleryOnDark" />
    </LinearLayout>

    <!-- 菜单-底部：进度(拖动带页码气泡) + 排版/更多两面板，上缘圆角 -->
    <LinearLayout
        android:id="@+id/menuBottom"
        android:orientation="vertical"
        android:background="@drawable/bg_reader_menu"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="14dp"
        android:layout_gravity="bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvPagePos"
                android:textSize="11sp"
                android:textColor="@color/gallerySubtle"
                android:minWidth="76dp"
                android:fontFeatureSettings="tnum"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <FrameLayout
                android:layout_marginStart="10dp"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content">

                <SeekBar
                    android:id="@+id/seek"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:thumbTint="@color/accent"
                    android:progressTint="@color/accent"
                    android:progressBackgroundTint="@color/gallerySubtle"
                    android:minHeight="24dp" />

                <!-- 拖动进度时的页码气泡 -->
                <TextView
                    android:id="@+id/seekBubble"
                    android:visibility="gone"
                    android:textSize="11sp"
                    android:textColor="@color/inkPrimary"
                    android:background="@drawable/bg_seek_bubble"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:orientation="horizontal"
            android:gravity="start|center_vertical"
            android:paddingTop="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/menuTabStyle"
                android:text="@string/menu_style"
                android:textSize="13sp"
                android:textColor="@color/galleryOnDark"
                android:background="@drawable/bg_menu_tab_line"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:paddingTop="2dp"
                android:paddingBottom="6dp"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
            <TextView
                android:id="@+id/menuTabMore"
                android:text="@string/menu_more"
                android:textSize="13sp"
                android:textColor="@color/gallerySubtle"
                android:background="@drawable/bg_menu_tab_line"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:paddingTop="2dp"
                android:paddingBottom="6dp"
                android:layout_marginStart="22dp"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/menuPanels"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- 排版面板：字号 / 行距 / 边距 / 字体 + 主题色卡 -->
            <LinearLayout
                android:id="@+id/panelStyle"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:id="@+id/btnFontDown"
                        android:text="A−"
                        style="@style/ReaderMenuItem" />
                    <TextView
                        android:id="@+id/tvFont"
                        android:text="17"
                        android:textSize="12sp"
                        android:textColor="@color/gallerySubtle"
                        android:gravity="center"
                        android:minWidth="22dp"
                        android:layout_gravity="center_vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                    <TextView
                        android:id="@+id/btnFontUp"
                        android:text="A+"
                        style="@style/ReaderMenuItem" />
                    <TextView
                        android:id="@+id/btnLine"
                        style="@style/ReaderMenuItem"
                        android:layout_marginStart="8dp" />
                    <TextView
                        android:id="@+id/btnPad"
                        style="@style/ReaderMenuItem"
                        android:layout_marginStart="8dp" />
                    <TextView
                        android:id="@+id/btnFontFamily"
                        style="@style/ReaderMenuItem"
                        android:layout_marginStart="8dp" />
                </LinearLayout>

                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <View
                            android:id="@+id/dotPaper"
                            android:background="@drawable/dot_paper"
                            android:layout_width="30dp"
                            android:layout_height="30dp" />
                        <TextView
                            android:text="纸白"
                            android:textSize="9sp"
                            android:textColor="@color/gallerySubtle"
                            android:layout_marginTop="4dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:layout_marginStart="14dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <View
                            android:id="@+id/dotSuede"
                            android:background="@drawable/dot_suede"
                            android:layout_width="30dp"
                            android:layout_height="30dp" />
                        <TextView
                            android:text="羊皮"
                            android:textSize="9sp"
                            android:textColor="@color/gallerySubtle"
                            android:layout_marginTop="4dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:layout_marginStart="14dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <View
                            android:id="@+id/dotGreen"
                            android:background="@drawable/dot_green"
                            android:layout_width="30dp"
                            android:layout_height="30dp" />
                        <TextView
                            android:text="护眼绿"
                            android:textSize="9sp"
                            android:textColor="@color/gallerySubtle"
                            android:layout_marginTop="4dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:layout_marginStart="14dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <View
                            android:id="@+id/dotNight"
                            android:background="@drawable/dot_night"
                            android:layout_width="30dp"
                            android:layout_height="30dp" />
                        <TextView
                            android:text="夜间"
                            android:textSize="9sp"
                            android:textColor="@color/gallerySubtle"
                            android:layout_marginTop="4dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/btnTheme"
                        style="@style/ReaderMenuItem"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="14dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 更多面板 -->
            <LinearLayout
                android:id="@+id/panelMore"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:id="@+id/btnFlip"
                        style="@style/ReaderMenuItem" />
                    <TextView
                        android:id="@+id/btnMarks"
                        style="@style/ReaderMenuItem"
                        android:layout_marginStart="8dp" />
                    <TextView
                        android:id="@+id/btnFinished"
                        style="@style/ReaderMenuItem"
                        android:layout_marginStart="8dp" />
                    <TextView
                        android:id="@+id/btnFloorJump"
                        android:text="@string/reader_floor_jump"
                        style="@style/ReaderMenuItem"
                        android:layout_marginStart="8dp" />
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:id="@+id/btnForum"
                        android:text="@string/reader_forum"
                        style="@style/ReaderMenuItem" />
                    <TextView
                        android:id="@+id/btnSearch"
                        android:text="搜索"
                        style="@style/ReaderMenuItem"
                        android:layout_marginStart="8dp" />
                    <TextView
                        android:id="@+id/btnAutoFinish"
                        style="@style/ReaderMenuItem"
                        android:layout_marginStart="8dp" />
                    <TextView
                        android:id="@+id/btnVolume"
                        style="@style/ReaderMenuItem"
                        android:layout_marginStart="8dp" />
                    <TextView
                        android:id="@+id/btnAwake"
                        style="@style/ReaderMenuItem"
                        android:layout_marginStart="8dp" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
