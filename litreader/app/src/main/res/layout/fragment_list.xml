<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/bgPaper"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 固定顶栏：56dp 起，页面标题 + 搜索 + 更多（刷新收进更多） -->
    <LinearLayout
        android:id="@+id/titleRow"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:textColor="@color/inkPrimary"
            android:textSize="24sp"
            android:fontFamily="serif"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <ImageButton
            android:id="@+id/btnSearch"
            android:contentDescription="@string/search"
            android:src="@drawable/ic_search"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/inkSecondary" />

        <ImageButton
            android:id="@+id/btnMore"
            android:contentDescription="@string/more"
            android:src="@drawable/ic_more"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/inkSecondary" />
    </LinearLayout>

    <!-- 标签横向滚动 + 筛选入口（阅读状态收进筛选面板，显式应用） -->
    <LinearLayout
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <HorizontalScrollView
            android:id="@+id/tagBar"
            android:scrollbars="none"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="wrap_content">
            <LinearLayout
                android:id="@+id/tagRow"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </HorizontalScrollView>

        <TextView
            android:id="@+id/btnFilter"
            android:text="@string/filter_sheet"
            android:textSize="13sp"
            android:textColor="@color/accent"
            android:background="?attr/selectableItemBackground"
            android:paddingStart="12dp"
            android:paddingEnd="6dp"
            android:minHeight="48dp"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- 目录同步进度（仅文学区使用）：缓存可先浏览，同步失败提示保留缓存 -->
    <TextView
        android:id="@+id/tvSyncStatus"
        android:visibility="gone"
        android:textSize="12sp"
        android:textColor="@color/inkSecondary"
        android:paddingStart="20dp"
        android:paddingEnd="12dp"
        android:paddingBottom="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- 内容区：列表 / 空态 / 骨架 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipe"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler"
                android:clipToPadding="false"
                android:paddingBottom="8dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <LinearLayout
            android:id="@+id/emptyBox"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:src="@drawable/ic_empty_book"
                android:importantForAccessibility="no"
                android:layout_width="96dp"
                android:layout_height="72dp"
                android:alpha="0.9" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/tvEmptyTitle"
                android:text="@string/empty_title"
                android:textColor="@color/inkPrimary"
                android:textSize="15sp"
                android:layout_marginTop="14dp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:id="@+id/tvEmptyHint"
                android:text="@string/empty_hint"
                android:textColor="@color/inkSecondary"
                android:textSize="12sp"
                android:gravity="center"
                android:paddingStart="32dp"
                android:paddingEnd="32dp" />
            <!-- 清除筛选：仅筛选零结果时显示（重置标签+阅读状态并回第一页） -->
            <TextView
                android:id="@+id/btnEmptyClear"
                android:text="@string/filter_clear"
                android:textSize="13sp"
                android:textColor="@color/accent"
                android:background="?attr/selectableItemBackground"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
            <TextView
                android:id="@+id/btnEmptyAction"
                android:text="@string/empty_action_refresh"
                android:textSize="13sp"
                android:textColor="@color/onPrimary"
                android:background="@drawable/bg_btn_accent"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_marginTop="12dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- 首屏加载骨架（呼吸动画），分页/下拉刷新用各自的轻量指示 -->
        <include
            android:id="@+id/skeleton"
            layout="@layout/skeleton_cards"
            android:visibility="gone" />
    </FrameLayout>

    <!-- 分页栏：页码=最后成功加载的页，点击弹出跳页 BottomSheet；前进靠列表无限滚动 -->
    <TextView
        android:id="@+id/tvPage"
        android:gravity="center"
        android:textColor="@color/inkSecondary"
        android:textSize="12sp"
        android:paddingTop="8dp"
        android:paddingBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>
