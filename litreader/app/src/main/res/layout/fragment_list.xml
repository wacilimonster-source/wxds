<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/bgPaper"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 顶栏：区名 + 搜索 + 更多 -->
    <LinearLayout
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="12dp"
        android:paddingTop="14dp"
        android:paddingBottom="6dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:textColor="@color/inkPrimary"
            android:textSize="22sp"
            android:fontFamily="serif"
            android:textStyle="bold" />
        <ImageButton
            android:id="@+id/btnRefresh"
            android:contentDescription="@string/refresh"
            android:src="@drawable/ic_refresh"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/inkSecondary" />
        <ImageButton
            android:id="@+id/btnSearch"
            android:contentDescription="@string/search"
            android:src="@drawable/ic_search"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/inkSecondary" />
        <ImageButton
            android:id="@+id/btnMore"
            android:contentDescription="@string/more"
            android:src="@drawable/ic_more"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/inkSecondary" />
    </LinearLayout>

    <!-- 已读状态筛选条（仅文学区使用） -->
    <HorizontalScrollView
        android:id="@+id/readBar"
        android:scrollbars="none"
        android:visibility="gone"
        android:paddingStart="20dp"
        android:paddingEnd="12dp"
        android:paddingBottom="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:id="@+id/readRow"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </HorizontalScrollView>

    <!-- 标签筛选条（按目录聚合动态生成） -->
    <HorizontalScrollView
        android:id="@+id/tagBar"
        android:scrollbars="none"
        android:visibility="gone"
        android:paddingStart="20dp"
        android:paddingEnd="12dp"
        android:paddingBottom="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:id="@+id/tagRow"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </HorizontalScrollView>

    <!-- 目录同步进度（仅文学区使用） -->
    <TextView
        android:id="@+id/tvSyncStatus"
        android:visibility="gone"
        android:textSize="12sp"
        android:textColor="@color/inkSecondary"
        android:paddingStart="20dp"
        android:paddingEnd="12dp"
        android:paddingBottom="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- 内容区：列表 / 空态 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipe"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler"
                android:clipToPadding="false"
                android:paddingBottom="8dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <LinearLayout
            android:id="@+id/emptyBox"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/tvEmptyTitle"
                android:text="@string/empty_title"
                android:textColor="@color/inkPrimary"
                android:textSize="15sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:id="@+id/tvEmptyHint"
                android:text="@string/empty_hint"
                android:textColor="@color/inkSecondary"
                android:textSize="12sp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progress"
            android:layout_gravity="center"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </FrameLayout>

    <!-- 分页栏 -->
    <LinearLayout
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="8dp"
        android:paddingTop="6dp"
        android:paddingBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageButton
            android:id="@+id/btnPrev"
            android:contentDescription="@string/prev_page"
            android:src="@drawable/ic_chevron_left"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/accent" />
        <TextView
            android:id="@+id/tvPage"
            android:gravity="center"
            android:textColor="@color/inkSecondary"
            android:textSize="13sp"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content" />
        <ImageButton
            android:id="@+id/btnNext"
            android:contentDescription="@string/next_page"
            android:src="@drawable/ic_chevron_right"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/accent" />
    </LinearLayout>
</LinearLayout>
